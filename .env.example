# ─── Frontend (.env.local) ───────────────────────────────────────
# URL of the chatbot Cloudflare Worker.
# Local dev:  http://localhost:8787 (Wrangler dev server)
# Production: the deployed Worker URL (also set as CHATBOT_API_URL GitHub secret).
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8787

# ─── Backend (api/.dev.vars — Cloudflare Worker dev secrets) ─────
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── IMPORTANT ───────────────────────────────────────────────────
# The frontend URL is baked into out/_config.js at build time.
# After changing this file, rebuild: pnpm run build
# Then serve: pnpm run serve
