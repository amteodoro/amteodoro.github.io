# ─── Frontend (.env.local) ───────────────────────────────────────
# The URL where the chatbot API is running.
# For local development, this should point to the Wrangler dev server (default: port 8787).
# For production (GitHub Pages), set this to your deployed Cloudflare Worker URL.
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8787

# ─── Backend (api/.dev.vars — Cloudflare Worker dev secrets) ─────
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── IMPORTANT ───────────────────────────────────────────────────
# NEXT_PUBLIC_ variables are baked into the static build at build time.
# After changing this file, you MUST rebuild: pnpm run export
# Then serve the static files: pnpm serve (or pnpm serve:all for both frontend + API)
