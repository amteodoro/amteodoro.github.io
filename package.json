{
  "name": "amteodoro-site",
  "version": "1.0.0",
  "private": true,
  "description": "amteodoro.github.io — static personal site (HTML/CSS/JS) + Cloudflare Workers chatbot API.",
  "scripts": {
    "config": "node -e \"require('fs').mkdirSync('out',{recursive:true});require('fs').writeFileSync('out/_config.js', 'window.AMT_API_URL = ' + JSON.stringify(process.env.NEXT_PUBLIC_CHATBOT_API_URL || '') + ';\\n')\"",
    "build": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').cpSync('public','out',{recursive:true});require('fs').writeFileSync('out/.nojekyll','')\" && pnpm run config",
    "export": "pnpm run build",
    "serve": "npx -y serve out",
    "dev:api": "cd api && npm run dev",
    "dev:all": "npx -y concurrently -n site,api -c cyan,yellow \"pnpm run build && pnpm run serve\" \"cd api && npm run dev\""
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
